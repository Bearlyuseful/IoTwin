name Diagnostics: identification, sessions, writing and reset
uds ecu 22F190 expect 62F190494F5457494E304C4947485444454D4F31   # VIN IOTWIN0LIGHTDEMO1
uds ecu 22F187 expect 62F187*                   # spare part number
uds ecu 22F186 expect 62F18601                  # default session
uds ecu 2E0103012C expect 7F2E7F                # writing needs the extended session
uds ecu 1003 expect 5003*
uds ecu 2E0103012C expect 6E0103                # blink every 300 ms
uds ecu 220103 expect 620103012C
expect 100#01 within 500
expect 100#00 within 500
uds ecu 3101 expect 7F3111                      # service not supported
uds ecu 1101 expect 5101                        # hard reset: application restarts
wait 100
uds ecu 22F186 expect 62F18601                  # back in the default session
uds ecu 220103 expect 6201030000                # blinking stopped by the reset
